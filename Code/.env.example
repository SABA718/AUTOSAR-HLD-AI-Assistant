# ==========================================
# AUTOSAR HLD AI Assistant - Environment Config
# ==========================================

# Application Settings
APP_ENV=development
APP_NAME=AUTOSAR HLD AI Assistant
LOG_LEVEL=INFO

# Storage & Directory Paths
DATA_DIR=./data
DOCUMENTS_DIR=./data/documents
CHROMA_DIR=./data/chroma_db
SQLITE_DB_PATH=./data/autosar_assistant.db

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# LLM Provider Configuration (mock | ollama | gemini | openai)
DEFAULT_LLM_PROVIDER=mock

# Local Ollama Provider Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Google Gemini Provider Settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI Provider Settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Service Networking
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=8501
